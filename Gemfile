source "https://rubygems.org"

# GitHub Pages builds this site itself; this Gemfile is for running it locally:
#
#     bundle install
#     bundle exec jekyll serve
#
# If the Jekyll toolchain will not install (it needs native extensions, so
# ruby-dev), tools/preview.rb renders a rough local preview with pure-Ruby gems.

gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-redirect-from"
end
